# Application
APP_NAME=Inventory API
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string-in-production

# Database
DATABASE_URL=postgresql+psycopg2://inventory:inventory@db:5432/inventory

# Redis (sessions + rate limit)
REDIS_URL=redis://redis:6379/0

# Session / Cookie
SESSION_COOKIE_NAME=inv_session
SESSION_TTL_SECONDS=86400
COOKIE_HTTPONLY=true
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Security
RATE_LIMIT_LOGIN_IP=10
RATE_LIMIT_LOGIN_ACCOUNT=5
ACCOUNT_LOCKOUT_THRESHOLD=5
ACCOUNT_LOCKOUT_MINUTES=15
PASSWORD_MIN_LENGTH=12

# CORS (comma separated)
CORS_ORIGINS=http://localhost:8000
